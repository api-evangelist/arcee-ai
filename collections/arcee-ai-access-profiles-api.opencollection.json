{
  "opencollection": "1.0.0",
  "info": {
    "name": "AFM Access Profiles API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Access Profiles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Access Profiles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/app/v1/access_profiles",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all access profiles"
        },
        {
          "info": {
            "name": "Create Access Profile",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/app/v1/access_profiles",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new access profile"
        },
        {
          "info": {
            "name": "Get Access Profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/app/v1/access_profiles/:profile_id",
            "params": [
              {
                "name": "profile_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get an access profile by ID"
        },
        {
          "info": {
            "name": "Update Access Profile",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/app/v1/access_profiles/:profile_id",
            "params": [
              {
                "name": "profile_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update an access profile"
        },
        {
          "info": {
            "name": "Delete Access Profile",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/app/v1/access_profiles/:profile_id",
            "params": [
              {
                "name": "profile_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete an access profile"
        },
        {
          "info": {
            "name": "Add Model To Access Profile",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/app/v1/access_profiles/:profile_id/models/:model_id",
            "params": [
              {
                "name": "profile_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "model_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "rate_limit_profile_id",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Add a model to an access profile"
        },
        {
          "info": {
            "name": "Remove Model From Access Profile",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/app/v1/access_profiles/:profile_id/models/:model_id",
            "params": [
              {
                "name": "profile_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "model_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Remove a model from an access profile"
        }
      ]
    }
  ],
  "bundled": true
}