{
  "opencollection": "1.0.0",
  "info": {
    "name": "AFM Access Profiles Dev Mode API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Dev Mode",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Dev Chat Completion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/app/v1/dev-mode/chat/completions",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "query",
                "description": "Existing dev session ID; creates new if omitted"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Dev mode chat completion endpoint (user-auth, no API key)."
        },
        {
          "info": {
            "name": "Dev List Sessions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/app/v1/dev-mode/sessions",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "from_date",
                "value": "",
                "type": "query"
              },
              {
                "name": "to_date",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List dev sessions for current user."
        },
        {
          "info": {
            "name": "Dev Get Session",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/app/v1/dev-mode/sessions/:session_id",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get dev session with messages."
        },
        {
          "info": {
            "name": "Dev Update Session Title",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/app/v1/dev-mode/sessions/:session_id",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update dev session title."
        },
        {
          "info": {
            "name": "Dev Delete Session",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/app/v1/dev-mode/sessions/:session_id",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete dev session and its messages."
        },
        {
          "info": {
            "name": "Dev List Messages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/app/v1/dev-mode/sessions/:session_id/messages",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List messages in a dev session."
        }
      ]
    }
  ],
  "bundled": true
}