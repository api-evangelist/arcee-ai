{
  "opencollection": "1.0.0",
  "info": {
    "name": "AFM Access Profiles Partners API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Partners",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Partners",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/app/v1/partners",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              },
              {
                "name": "search",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a paginated list of partners"
        },
        {
          "info": {
            "name": "Get Partner Detail",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/app/v1/partners/:partner_id",
            "params": [
              {
                "name": "partner_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get Partner details by ID"
        }
      ]
    }
  ],
  "bundled": true
}